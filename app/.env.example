APP_NAME="Plateforme citoyenne"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=votalis
DB_USERNAME=votalis
DB_PASSWORD=changez-moi

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Clé HMAC dédiée au haché des e-mails (distincte d'APP_KEY). Générer : php artisan votalis:hash-key
EMAIL_HASH_KEY=

# Docker (développement)
DOCKER_UID=1000
DOCKER_GID=1000
WEB_PORT=8080
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379

# Identifiant du commit déployé, injecté au build, affiché en pied de page
APP_COMMIT=

# Hachage des mots de passe
HASH_DRIVER=argon2id

# Plafonds de contribution (CDC 4.7) ; les valeurs de production vivent hors dépôt
CAP_PROPOSALS_PER_MONTH_PER_THEME=3
CAP_ARGUMENTS_PER_DAY=20
CAP_VOTES_PER_DAY=300
CAP_REPORTS_PER_DAY=10
CAP_NEW_ACCOUNT_DAYS=7
PROPOSAL_TYPO_RATIO=0.10

# Classements et vote rapide
RANKINGS_MIN_VOTES=10
RANKINGS_CACHE_SECONDS=300
QUICK_VOTE_RECENT_DAYS=14
QUICK_VOTE_RECENT_WEIGHT=3
QUICK_VOTE_LOW_VOTES=10
QUICK_VOTE_LOW_VOTES_WEIGHT=2

# Classement par consensus (lot 7) : désactivé tant que les seuils de participation ne sont pas
# atteints. Valeurs par défaut publiées dans docs/classement.md ; production : configuration privée.
CONSENSUS_ENABLED=false
# CONSENSUS_MIN_PARTICIPANTS=300
# CONSENSUS_MIN_PROPOSALS=50
# CONSENSUS_MIN_VOTES_PER_PARTICIPANT=7
# CONSENSUS_MIN_VOTERS_PER_GROUP=5
# CONSENSUS_K_MIN=2
# CONSENSUS_K_MAX=5
# CONSENSUS_ALPHA=1.0
# CONSENSUS_SEED=
# CONSENSUS_MAX_AGE_HOURS=24

# Service d'embeddings interne et recherche
EMBEDDINGS_URL=http://localhost:8001
EMBEDDINGS_ALLOWED_HOSTS=embeddings,localhost,127.0.0.1
EMBEDDINGS_TIMEOUT=5
EMBEDDINGS_DIMENSION=384
EMBEDDINGS_VERSION=multilingual-e5-small@1
DUPLICATES_THRESHOLD=0.89
DUPLICATES_LIMIT=5
CONDITIONS_THRESHOLD=0.86
APPEAL_DAYS=14
REWRITE_DAYS=14
# Parcours personnel (lot 6) : nombre de thèmes de premier niveau pour le jalon « Exploration ».
JOURNEY_EXPLORATION_THEMES=5

# Seuils des signaux d'intégrité : à renseigner dans la configuration privée uniquement. Vide = signal désactivé.
INTEGRITY_REGISTRATION_SPIKE=
INTEGRITY_VOTE_SPIKE=
INTEGRITY_IDENTICAL_VOTING_MIN_SHARED=
INTEGRITY_DUPLICATE_CONTENT_SIMILARITY=
INTEGRITY_NIGHT_SHARE=
PUBLIC_CACHE_SECONDS=60
RETENTION_INACTIVE_MONTHS=36
RETENTION_NOTICE_DAYS=30
# Mentions légales (à renseigner en production).
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_DPO_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_PUBLICATION_DIRECTOR=
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=changez-moi
