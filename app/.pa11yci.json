{
  "defaults": {
    "standard": "WCAG2AA",
    "runners": [
      "axe",
      "htmlcs"
    ],
    "timeout": 60000,
    "wait": 1500,
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox"
      ],
      "executablePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    },
    "hideElements": "[wire\\:loading]"
  },
  "urls": [
    "http://localhost:8080/",
    "http://localhost:8080/themes/economie",
    "http://localhost:8080/propositions/1",
    "http://localhost:8080/inscription",
    {
      "url": "http://localhost:8080/vote-rapide",
      "actions": [
        "wait for element #identifier to be visible",
        "set field #identifier to participante@example.test",
        "set field #password to mot-de-passe-de-test-123",
        "click element button[type=submit]",
        "wait for path to be /vote-rapide"
      ]
    },
    {
      "url": "http://localhost:8080/mon-compte/parcours",
      "actions": [
        "wait for element #identifier to be visible",
        "set field #identifier to participante@example.test",
        "set field #password to mot-de-passe-de-test-123",
        "click element button[type=submit]",
        "wait for path to be /mon-compte/parcours"
      ]
    }
  ]
}