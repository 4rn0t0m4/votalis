# Image de production : dépendances sans dev, ressources compilées, code en lecture seule.
# Construction (racine du dépôt) : docker build -f infra/docker/php/Dockerfile.prod -t votalis-app:<commit> .

FROM node:22-alpine AS assets
WORKDIR /build
COPY app/package.json app/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY app/ ./
RUN npm run build

FROM composer:2 AS vendor
WORKDIR /build
COPY app/composer.json app/composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-progress --no-scripts --ignore-platform-reqs
COPY app/ ./
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative

FROM php:8.4-fpm-alpine
COPY --from=mlocati/php-extension-installer:2 /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions pdo_pgsql pgsql redis intl zip bcmath opcache pcntl gd \
    && apk add --no-cache postgresql16-client
COPY infra/docker/php/php.ini /usr/local/etc/php/conf.d/votalis.ini
RUN { echo 'opcache.enable=1'; echo 'opcache.validate_timestamps=0'; echo 'opcache.memory_consumption=192'; echo 'opcache.max_accelerated_files=20000'; } > /usr/local/etc/php/conf.d/opcache-prod.ini

WORKDIR /var/www/app
COPY --from=vendor /build /var/www/app
COPY --from=assets /build/public/build /var/www/app/public/build
RUN addgroup -g 1000 app && adduser -D -u 1000 -G app app \
    && chown -R app:app storage bootstrap/cache
USER app

# config:cache, route:cache, view:cache et migrate sont lancés au déploiement (docs/exploitation.md),
# une fois l'environnement injecté.
CMD ["php-fpm"]
